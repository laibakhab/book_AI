import os
from typing import Optional


class Settings:
    """
    Configuration settings for the RAG Agent Backend.
    Loaded from environment variables with sensible defaults.
    """
    
    # Qdrant Configuration
    QDRANT_URL: str = os.getenv("https://f681ebeb-55eb-44dd-bf8f-a66c76fcbb02.europe-west3-0.gcp.cloud.qdrant.io:6333", "http://localhost:6333")
    QDRANT_API_KEY: Optional[str] = os.getenv("QDRANT_API_KEY", None)
    QDRANT_COLLECTION: str = os.getenv("QDRANT_COLLECTION", "book_content")
    
    # OpenAI Configuration
    OPENAI_API_KEY: str = os.getenv("OPENAI_API_KEY", "")
    OPENAI_MODEL: str = os.getenv("OPENAI_MODEL", "gpt-4-turbo")
    
    # Agent Configuration
    DEFAULT_TOP_K: int = int(os.getenv("DEFAULT_TOP_K", "5"))
    MIN_TOP_K: int = int(os.getenv("MIN_TOP_K", "1"))
    MAX_TOP_K: int = int(os.getenv("MAX_TOP_K", "20"))
    
    # Temperature settings for response generation
    DEFAULT_TEMPERATURE: float = float(os.getenv("DEFAULT_TEMPERATURE", "0.7"))
    MIN_TEMPERATURE: float = float(os.getenv("MIN_TEMPERATURE", "0.0"))
    MAX_TEMPERATURE: float = float(os.getenv("MAX_TEMPERATURE", "1.0"))
    
    # Confidence threshold for responses
    CONFIDENCE_THRESHOLD: float = float(os.getenv("CONFIDENCE_THRESHOLD", "0.5"))
    
    # Maximum tokens for response generation
    MAX_RESPONSE_TOKENS: int = int(os.getenv("MAX_RESPONSE_TOKENS", "1000"))
    
    # Performance settings
    REQUEST_TIMEOUT: int = int(os.getenv("REQUEST_TIMEOUT", "30"))  # seconds
    
    # Validation and quality settings
    ENABLE_CONTENT_VALIDATION: bool = os.getenv("ENABLE_CONTENT_VALIDATION", "true").lower() == "true"
    ENABLE_CITATION_CHECK: bool = os.getenv("ENABLE_CITATION_CHECK", "true").lower() == "true"
    
    def validate(self) -> bool:
        """
        Validate that all required settings are properly configured.
        
        Returns:
            True if all required settings are valid, False otherwise
        """
        errors = []
        
        # Validate required API keys are present
        if not self.OPENAI_API_KEY:
            errors.append("OPENAI_API_KEY is required")
        
        if not self.QDRANT_URL:
            errors.append("QDRANT_URL is required")
        
        # Validate top_k values
        if self.MIN_TOP_K <= 0:
            errors.append(f"MIN_TOP_K must be greater than 0, got {self.MIN_TOP_K}")
        
        if self.MAX_TOP_K < self.MIN_TOP_K:
            errors.append(f"MAX_TOP_K ({self.MAX_TOP_K}) must be >= MIN_TOP_K ({self.MIN_TOP_K})")
        
        if self.DEFAULT_TOP_K < self.MIN_TOP_K or self.DEFAULT_TOP_K > self.MAX_TOP_K:
            errors.append(
                f"DEFAULT_TOP_K ({self.DEFAULT_TOP_K}) must be between "
                f"MIN_TOP_K ({self.MIN_TOP_K}) and MAX_TOP_K ({self.MAX_TOP_K})"
            )
        
        # Validate temperature values
        if self.MIN_TEMPERATURE < 0.0 or self.MIN_TEMPERATURE > 1.0:
            errors.append(f"MIN_TEMPERATURE must be between 0.0 and 1.0, got {self.MIN_TEMPERATURE}")
        
        if self.MAX_TEMPERATURE < 0.0 or self.MAX_TEMPERATURE > 1.0:
            errors.append(f"MAX_TEMPERATURE must be between 0.0 and 1.0, got {self.MAX_TEMPERATURE}")
        
        if self.DEFAULT_TEMPERATURE < self.MIN_TEMPERATURE or self.DEFAULT_TEMPERATURE > self.MAX_TEMPERATURE:
            errors.append(
                f"DEFAULT_TEMPERATURE ({self.DEFAULT_TEMPERATURE}) must be between "
                f"MIN_TEMPERATURE ({self.MIN_TEMPERATURE}) and MAX_TEMPERATURE ({self.MAX_TEMPERATURE})"
            )
        
        # Validate confidence threshold
        if self.CONFIDENCE_THRESHOLD < 0.0 or self.CONFIDENCE_THRESHOLD > 1.0:
            errors.append(f"CONFIDENCE_THRESHOLD must be between 0.0 and 1.0, got {self.CONFIDENCE_THRESHOLD}")
        
        # Validate max response tokens
        if self.MAX_RESPONSE_TOKENS <= 0:
            errors.append(f"MAX_RESPONSE_TOKENS must be greater than 0, got {self.MAX_RESPONSE_TOKENS}")
        
        # Validate timeout
        if self.REQUEST_TIMEOUT <= 0:
            errors.append(f"REQUEST_TIMEOUT must be greater than 0, got {self.REQUEST_TIMEOUT}")
        
        if errors:
            for error in errors:
                print(f"Configuration error: {error}")
            return False
        
        return True


# Create a singleton instance
settings = Settings()

